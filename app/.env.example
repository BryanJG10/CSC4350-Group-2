# Fallback configuration for the backend.
#
# The team keeps real credentials in Doppler, so you normally do not need this
# file at all. Copy it only when you have no access to the Doppler project yet.
#
#   Copy-Item .env.example .env
#
# The copied file is git-ignored. Never commit real values, and never paste them
# into a chat window or an issue. Environment variables from Doppler take
# precedence over anything written here.

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_POOL_SIZE=5
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
